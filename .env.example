# External Flight Provider (Amadeus API)
AMADEUS_CLIENT_ID=your-amadeus-client-id
AMADEUS_CLIENT_SECRET=your-amadeus-client-secret

# Database (PostgreSQL 18 - used by docker-compose.yml and SPRING_PROFILES_ACTIVE=prod)
DB_NAME=tripmint
DB_PORT=5432
DB_URL=jdbc:postgresql://localhost:5432/tripmint
DB_USERNAME=tripmint
DB_PASSWORD=change-me
